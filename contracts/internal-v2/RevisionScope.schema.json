{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "day_indices": {
      "items": {
        "type": "integer"
      },
      "maxItems": 30,
      "title": "Day Indices",
      "type": "array"
    },
    "activity_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 300,
      "title": "Activity Ids",
      "type": "array"
    },
    "start_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start At"
    },
    "end_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End At"
    }
  },
  "title": "RevisionScope",
  "type": "object"
}
