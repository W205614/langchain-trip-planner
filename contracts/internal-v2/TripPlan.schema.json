{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Attraction": {
      "additionalProperties": true,
      "description": "景点信息",
      "properties": {
        "name": {
          "description": "景点名称",
          "title": "Name",
          "type": "string"
        },
        "activity_id": {
          "default": "",
          "title": "Activity Id",
          "type": "string"
        },
        "optional": {
          "default": true,
          "title": "Optional",
          "type": "boolean"
        },
        "priority": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "address": {
          "description": "地址",
          "title": "Address",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location",
          "description": "经纬度坐标"
        },
        "visit_duration": {
          "description": "建议游览时间(分钟)",
          "title": "Visit Duration",
          "type": "integer"
        },
        "description": {
          "description": "景点描述",
          "title": "Description",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "景点",
          "description": "景点类别",
          "title": "Category"
        },
        "rating": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "评分",
          "title": "Rating"
        },
        "photos": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "景点图片URL列表",
          "title": "Photos"
        },
        "poi_id": {
          "description": "高德 POI ID",
          "minLength": 1,
          "title": "Poi Id",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "图片URL",
          "title": "Image Url"
        },
        "ticket_price": {
          "default": 0,
          "description": "门票价格(元)",
          "title": "Ticket Price",
          "type": "integer"
        },
        "price_source": {
          "default": "unknown",
          "title": "Price Source",
          "type": "string"
        },
        "requested_names": {
          "items": {
            "type": "string"
          },
          "title": "Requested Names",
          "type": "array"
        },
        "opening_hours": {
          "default": "",
          "title": "Opening Hours",
          "type": "string"
        },
        "fact_source": {
          "default": "",
          "title": "Fact Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "address",
        "location",
        "visit_duration",
        "description",
        "poi_id"
      ],
      "title": "Attraction",
      "type": "object"
    },
    "Budget": {
      "description": "预算信息",
      "properties": {
        "total_attractions": {
          "default": 0,
          "description": "景点门票总费用",
          "title": "Total Attractions",
          "type": "integer"
        },
        "total_hotels": {
          "default": 0,
          "description": "酒店总费用",
          "title": "Total Hotels",
          "type": "integer"
        },
        "total_meals": {
          "default": 0,
          "description": "餐饮总费用",
          "title": "Total Meals",
          "type": "integer"
        },
        "total_transportation": {
          "default": 0,
          "description": "交通总费用",
          "title": "Total Transportation",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "description": "总费用",
          "title": "Total",
          "type": "integer"
        },
        "estimated": {
          "default": true,
          "title": "Estimated",
          "type": "boolean"
        },
        "unknown_items": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Items",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "limit_total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "用户整段行程预算上限",
          "title": "Limit Total"
        },
        "within_limit": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "估算总额是否在预算内",
          "title": "Within Limit"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CitySegment": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "maxLength": 32,
          "minLength": 1,
          "title": "City",
          "type": "string"
        },
        "start_day": {
          "maximum": 29,
          "minimum": 0,
          "title": "Start Day",
          "type": "integer"
        },
        "end_day": {
          "maximum": 29,
          "minimum": 0,
          "title": "End Day",
          "type": "integer"
        }
      },
      "required": [
        "city",
        "start_day",
        "end_day"
      ],
      "title": "CitySegment",
      "type": "object"
    },
    "DayPlan": {
      "additionalProperties": true,
      "properties": {
        "city": {
          "default": "",
          "title": "City",
          "type": "string"
        },
        "timeline": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Timeline",
          "type": "array"
        },
        "feasibility": {
          "additionalProperties": true,
          "title": "Feasibility",
          "type": "object"
        },
        "date": {
          "description": "日期 YYYY-MM-DD",
          "title": "Date",
          "type": "string"
        },
        "day_index": {
          "description": "第几天(从0开始)",
          "title": "Day Index",
          "type": "integer"
        },
        "description": {
          "description": "当日行程描述",
          "title": "Description",
          "type": "string"
        },
        "theme": {
          "default": "",
          "description": "当日主题",
          "title": "Theme",
          "type": "string"
        },
        "activities": {
          "description": "除景点外的当日活动建议",
          "items": {
            "type": "string"
          },
          "title": "Activities",
          "type": "array"
        },
        "transportation": {
          "description": "交通方式",
          "title": "Transportation",
          "type": "string"
        },
        "accommodation": {
          "description": "住宿",
          "title": "Accommodation",
          "type": "string"
        },
        "hotel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hotel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "推荐酒店"
        },
        "attractions": {
          "default": [],
          "description": "景点列表",
          "items": {
            "$ref": "#/$defs/Attraction"
          },
          "title": "Attractions",
          "type": "array"
        },
        "meals": {
          "default": [],
          "description": "餐饮列表",
          "items": {
            "$ref": "#/$defs/Meal"
          },
          "title": "Meals",
          "type": "array"
        },
        "generation_mode": {
          "default": "llm",
          "description": "生成来源: llm 或 fallback",
          "title": "Generation Mode",
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "降级原因（如 timeout）",
          "title": "Fallback Reason"
        }
      },
      "required": [
        "date",
        "day_index",
        "description",
        "transportation",
        "accommodation"
      ],
      "title": "DayPlan",
      "type": "object"
    },
    "DayWindow": {
      "additionalProperties": false,
      "properties": {
        "day_index": {
          "maximum": 29,
          "minimum": 0,
          "title": "Day Index",
          "type": "integer"
        },
        "start": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "day_index",
        "start",
        "end"
      ],
      "title": "DayWindow",
      "type": "object"
    },
    "Hotel": {
      "description": "酒店信息",
      "properties": {
        "name": {
          "description": "酒店名称",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "default": "",
          "description": "酒店地址",
          "title": "Address",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "酒店位置"
        },
        "price_range": {
          "default": "",
          "description": "价格范围",
          "title": "Price Range",
          "type": "string"
        },
        "rating": {
          "default": "",
          "description": "评分",
          "title": "Rating",
          "type": "string"
        },
        "distance": {
          "default": "",
          "description": "距离景点距离",
          "title": "Distance",
          "type": "string"
        },
        "type": {
          "default": "",
          "description": "酒店类型",
          "title": "Type",
          "type": "string"
        },
        "estimated_cost": {
          "default": 0,
          "description": "预估费用(元/晚)",
          "title": "Estimated Cost",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "Hotel",
      "type": "object"
    },
    "Location": {
      "description": "地理位置",
      "properties": {
        "longitude": {
          "description": "经度",
          "title": "Longitude",
          "type": "number"
        },
        "latitude": {
          "description": "纬度",
          "title": "Latitude",
          "type": "number"
        }
      },
      "required": [
        "longitude",
        "latitude"
      ],
      "title": "Location",
      "type": "object"
    },
    "Meal": {
      "additionalProperties": true,
      "description": "餐饮信息",
      "properties": {
        "type": {
          "description": "餐饮类型: breakfast/lunch/dinner/snack",
          "title": "Type",
          "type": "string"
        },
        "activity_id": {
          "default": "",
          "title": "Activity Id",
          "type": "string"
        },
        "name": {
          "description": "餐饮名称",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "地址",
          "title": "Address"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "经纬度坐标"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "描述",
          "title": "Description"
        },
        "estimated_cost": {
          "default": 0,
          "description": "预估费用(元)",
          "title": "Estimated Cost",
          "type": "integer"
        },
        "poi_id": {
          "default": "",
          "description": "高德餐饮 POI ID；空值表示上游未取得可信餐厅",
          "title": "Poi Id",
          "type": "string"
        },
        "opening_hours": {
          "default": "",
          "description": "餐厅营业时间原始文本",
          "title": "Opening Hours",
          "type": "string"
        },
        "fact_source": {
          "default": "",
          "description": "餐饮信息来源",
          "title": "Fact Source",
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "Meal",
      "type": "object"
    },
    "PlanningConstraints": {
      "description": "Human names are resolved against trusted candidates by the planning service.",
      "properties": {
        "must_visit": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Must Visit",
          "type": "array"
        },
        "avoid": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Avoid",
          "type": "array"
        },
        "daily_minutes": {
          "default": 600,
          "maximum": 900,
          "minimum": 120,
          "title": "Daily Minutes",
          "type": "integer"
        },
        "max_inter_stop_walking_km": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 30,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Inter Stop Walking Km"
        }
      },
      "title": "PlanningConstraints",
      "type": "object"
    },
    "PlanningInput": {
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "default": "Asia/Shanghai",
          "title": "Timezone",
          "type": "string"
        },
        "day_start": {
          "default": "09:00",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Day Start",
          "type": "string"
        },
        "day_end": {
          "default": "20:00",
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Day End",
          "type": "string"
        },
        "day_windows": {
          "items": {
            "$ref": "#/$defs/DayWindow"
          },
          "maxItems": 30,
          "title": "Day Windows",
          "type": "array"
        },
        "city_segments": {
          "items": {
            "$ref": "#/$defs/CitySegment"
          },
          "maxItems": 30,
          "title": "City Segments",
          "type": "array"
        },
        "commitments": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 300,
          "title": "Commitments",
          "type": "array"
        },
        "hotel_stays": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 30,
          "title": "Hotel Stays",
          "type": "array"
        },
        "meal_windows": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 8,
          "title": "Meal Windows",
          "type": "array"
        },
        "opening_windows": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 500,
          "title": "Opening Windows",
          "type": "array"
        },
        "reservation_facts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 300,
          "title": "Reservation Facts",
          "type": "array"
        },
        "transport_buffers": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 300,
          "title": "Transport Buffers",
          "type": "array"
        },
        "poi_relations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 300,
          "title": "Poi Relations",
          "type": "array"
        },
        "meal_resolutions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 300,
          "title": "Meal Resolutions",
          "type": "array"
        },
        "locks": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 300,
          "title": "Locks",
          "type": "array"
        },
        "completed_activity_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 300,
          "title": "Completed Activity Ids",
          "type": "array"
        },
        "arrival_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival At"
        },
        "departure_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure At"
        },
        "budget_mode": {
          "default": "estimate",
          "enum": [
            "estimate",
            "confirmed"
          ],
          "title": "Budget Mode",
          "type": "string"
        },
        "budget_cents": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Cents"
        },
        "revision_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PlanningInput",
      "type": "object"
    },
    "RevisionScope": {
      "additionalProperties": false,
      "properties": {
        "day_indices": {
          "items": {
            "type": "integer"
          },
          "maxItems": 30,
          "title": "Day Indices",
          "type": "array"
        },
        "activity_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 300,
          "title": "Activity Ids",
          "type": "array"
        },
        "start_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start At"
        },
        "end_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End At"
        }
      },
      "title": "RevisionScope",
      "type": "object"
    },
    "WeatherInfo": {
      "description": "天气信息",
      "properties": {
        "date": {
          "description": "日期 YYYY-MM-DD",
          "title": "Date",
          "type": "string"
        },
        "day_weather": {
          "default": "",
          "description": "白天天气",
          "title": "Day Weather",
          "type": "string"
        },
        "night_weather": {
          "default": "",
          "description": "夜间天气",
          "title": "Night Weather",
          "type": "string"
        },
        "day_temp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "白天温度；缺失时为未知",
          "title": "Day Temp"
        },
        "night_temp": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "夜间温度；缺失时为未知",
          "title": "Night Temp"
        },
        "wind_direction": {
          "default": "",
          "description": "风向",
          "title": "Wind Direction",
          "type": "string"
        },
        "wind_power": {
          "default": "",
          "description": "风力",
          "title": "Wind Power",
          "type": "string"
        }
      },
      "required": [
        "date"
      ],
      "title": "WeatherInfo",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "planning_input": {
      "$ref": "#/$defs/PlanningInput"
    },
    "city": {
      "description": "目的地城市",
      "title": "City",
      "type": "string"
    },
    "departure_city": {
      "default": "",
      "description": "出发地",
      "title": "Departure City",
      "type": "string"
    },
    "traveler_count": {
      "default": 1,
      "maximum": 20,
      "minimum": 1,
      "title": "Traveler Count",
      "type": "integer"
    },
    "room_count": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Room Count",
      "type": "integer"
    },
    "start_date": {
      "description": "开始日期",
      "title": "Start Date",
      "type": "string"
    },
    "end_date": {
      "description": "结束日期",
      "title": "End Date",
      "type": "string"
    },
    "days": {
      "description": "每日行程",
      "items": {
        "$ref": "#/$defs/DayPlan"
      },
      "title": "Days",
      "type": "array"
    },
    "weather_info": {
      "default": [],
      "description": "天气信息",
      "items": {
        "$ref": "#/$defs/WeatherInfo"
      },
      "title": "Weather Info",
      "type": "array"
    },
    "weather_notice": {
      "default": "",
      "description": "天气预报覆盖范围说明",
      "title": "Weather Notice",
      "type": "string"
    },
    "enrichment_notices": {
      "description": "可选资料增强缺口",
      "items": {
        "type": "string"
      },
      "title": "Enrichment Notices",
      "type": "array"
    },
    "overall_suggestions": {
      "description": "总体建议",
      "title": "Overall Suggestions",
