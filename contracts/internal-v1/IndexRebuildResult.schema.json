{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "success": {
      "title": "Success",
      "type": "boolean"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "chunks": {
      "minimum": 0,
      "title": "Chunks",
      "type": "integer"
    },
    "history_records": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "History Records"
    },
    "generation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation"
    },
    "preview": {
      "default": false,
      "title": "Preview",
      "type": "boolean"
    },
    "embedding_identity": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Embedding Identity"
    },
    "source_fingerprint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Fingerprint"
    },
    "estimated_embedding_requests": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Embedding Requests"
    },
    "input_utf8_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Utf8 Bytes"
    }
  },
  "required": [
    "success",
    "chunks"
  ],
  "title": "IndexRebuildResult",
  "type": "object"
}
