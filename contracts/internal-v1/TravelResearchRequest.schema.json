{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "来源优先研究请求；行程上下文由 Java 在鉴权后按需注入。",
  "properties": {
    "city": {
      "maxLength": 64,
      "minLength": 1,
      "title": "City",
      "type": "string"
    },
    "query": {
      "maxLength": 300,
      "minLength": 2,
      "title": "Query",
      "type": "string"
    },
    "trip_context": {
      "default": "",
      "maxLength": 8000,
      "title": "Trip Context",
      "type": "string"
    }
  },
  "required": [
    "city",
    "query"
  ],
  "title": "TravelResearchRequest",
  "type": "object"
}
