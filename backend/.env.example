# ============ LLM 配置 ============
# 使用 langchain-openai ChatOpenAI, 兼容任意 OpenAI 协议端点 (OpenAI / DeepSeek / 通义 / 中转代理等)
# 也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 旧命名

# 模型名称 (DeepSeek: deepseek-chat / deepseek-v4-flash, OpenAI: gpt-4o, 通义: qwen-plus ...)
LLM_MODEL_ID=

# API密钥
LLM_API_KEY=

# 服务地址 (OpenAI官方端点留空即可; DeepSeek填 https://api.deepseek.com/v1; 中转/代理填对应 base_url)
LLM_BASE_URL=

# 图文知识解析默认使用 deepseek-v4-flash-vision-exp，并复用上面的 LLM Key/Base URL。
# 仅在需要切换视觉模型时取消注释；行程生成仍使用 LLM_MODEL_ID。
# VISION_MODEL_ID=other-vision-model

# 温度 (可选, 默认0.7)
LLM_TEMPERATURE=0.7

# 全局单次调用超时与单日硬上限（实际取两者较小值）
LLM_TIMEOUT=60
LLM_DAY_TIMEOUT=45

# 逐日生成最大并发数（默认4；供应商限流时可下调为2）
LLM_CONCURRENCY=4

# 单日紧凑 JSON 的最大输出 Token（默认1800；低于800会被配置校验拒绝）
LLM_DAY_MAX_TOKENS=1800

# 可选：按当前供应商账单填写每百万 token 的美元单价。
# 默认 0 表示仅记录供应商返回 token，不输出未经校准的成本估算。
LLM_INPUT_PRICE_PER_MILLION_USD=0
LLM_OUTPUT_PRICE_PER_MILLION_USD=0
VISION_INPUT_PRICE_PER_MILLION_USD=0
VISION_OUTPUT_PRICE_PER_MILLION_USD=0

# ============ 服务器配置 ============
# 端口: Windows 上 8000 可能落在系统保留端口段(可 netsh int ipv4 show excludedportrange 查看),
# 被保留时绑定会报 WinError 10013, 本项目默认用 9000
HOST=0.0.0.0
PORT=9000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# ============ 高德地图 API ============
# 后端搜景点/天气/路线用 (Web服务 key)
AMAP_API_KEY=

# 热点城市事实缓存（秒）；POI 默认15分钟，天气默认5分钟。设为0可关闭排障。
AMAP_POI_CACHE_TTL_SECONDS=900
AMAP_WEATHER_CACHE_TTL_SECONDS=300

# ============ RAG 知识库配置 ============
# 嵌入模型走 OpenAI 兼容接口/中转 (可独立于 LLM 配置)。
# 若 EMBEDDING_BASE_URL / EMBEDDING_API_KEY 留空, 则缺省复用 LLM_BASE_URL + LLM_API_KEY。
# 全部留空则 RAG 自动禁用, 不影响主流程。

# 嵌入模型名（与运行时默认值一致）
EMBEDDING_MODEL=text-embedding-v4

# 嵌入中转地址与密钥 (建议显式配置; 缺省复用 LLM_BASE_URL / LLM_API_KEY)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 接口鉴权 (JWT) — 生产务必改为强随机值 (python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=dev-secret-change-me
