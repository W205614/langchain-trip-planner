# ============ LLM 配置 ============
# 使用 OpenAI 官方 API；模型密钥仅保存在后端。
# 也兼容 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 旧命名

# 文本生成与改排
LLM_MODEL_ID=gpt-6.1-sol

# API密钥
LLM_API_KEY=

LLM_BASE_URL=https://api.openai.com/v1
LLM_REASONING_EFFORT=low

# 图文解析复用官方账号，单独密钥留空时继承 LLM_API_KEY。
VISION_MODEL_ID=gpt-6.1-sol
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_REASONING_EFFORT=low

# 仅兼容模型使用温度；GPT-6 请求不会发送此参数。
LLM_TEMPERATURE=0.7

# 全局单次调用超时与单日硬上限（实际取两者较小值）
LLM_TIMEOUT=60
LLM_DAY_TIMEOUT=45
# 攻略问答模型预算；需短于 Java 25 秒的端到端流式预算
LLM_RESEARCH_TIMEOUT=15

# 逐日生成最大并发数（默认4；供应商限流时可下调为2）
LLM_CONCURRENCY=4

# Java 业务服务的任务执行并发数（默认4）
LLM_REQUEST_MAX_CONCURRENCY=4

# 单日紧凑 JSON 的最大输出 Token（默认1800；低于800会被配置校验拒绝）
LLM_DAY_MAX_TOKENS=1800

# 可选：按当前供应商账单填写每百万 token 的美元单价。
# 默认 0 表示仅记录供应商返回 token，不输出未经校准的成本估算。
LLM_INPUT_PRICE_PER_MILLION_USD=0
LLM_OUTPUT_PRICE_PER_MILLION_USD=0
VISION_INPUT_PRICE_PER_MILLION_USD=0
VISION_OUTPUT_PRICE_PER_MILLION_USD=0

# ============ 服务器配置 ============
# 端口: Windows 上 8000 可能落在系统保留端口段(可 netsh int ipv4 show excludedportrange 查看),
# 被保留时绑定会报 WinError 10013, 本项目默认用 9000
HOST=0.0.0.0
PORT=9000

# 日志级别
LOG_LEVEL=INFO

# ============ 高德地图 API ============
# Java 传统业务和最终核验使用的 Web 服务 Key。
AMAP_REST_API_KEY=
# Python Agent 使用的 MCP Key；开发环境可以与 REST Key 相同，生产建议独立。
AMAP_MCP_API_KEY=
# 旧 AMAP_API_KEY 仅作配置生成兼容回退，新部署请使用上面两个变量。
AMAP_API_KEY=
# Agent 固定使用高德官方 Streamable HTTP MCP，不自动切换到 Java REST。
AMAP_TRANSPORT=mcp
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_TIMEOUT_SECONDS=20
AMAP_MCP_SEARCH_LIMIT=10

# 热点城市事实缓存（秒）；POI 默认15分钟，天气默认5分钟。设为0可关闭排障。
AMAP_POI_CACHE_TTL_SECONDS=900
AMAP_WEATHER_CACHE_TTL_SECONDS=300
AMAP_DETAIL_CACHE_TTL_SECONDS=3600
AMAP_CACHE_MAXIMUM_SIZE=1000

# ============ RAG 知识库配置 ============
# 嵌入使用 OpenAI 官方服务。
# 若 EMBEDDING_BASE_URL / EMBEDDING_API_KEY 留空, 则缺省复用 LLM_BASE_URL + LLM_API_KEY。
# 全部留空则 RAG 自动禁用, 不影响主流程。

# 嵌入模型名（与运行时默认值一致）
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# OpenAI 官方 Embedding 地址与密钥；密钥留空时继承 LLM_API_KEY。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# Java 接口鉴权 (JWT)：首次配置脚本在空值时生成强随机值，不传给 Agent。
JWT_SECRET_KEY=

# 持久化任务和可配置运行目录（空值沿用 backend/data 与 backend/logs）
DATA_DIR=
CHROMA_DIR=
LOG_DIR=
RAG_ENABLED=true

# Public operations are opt-in; existing local installations keep legacy registration.
PUBLIC_REGISTRATION_MODE=legacy
PUBLIC_BASE_URL=http://localhost:8380
ADMIN_MFA_REQUIRED=false
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM=

# Original files: local by default, private S3-compatible bucket when configured.
UPLOAD_STORAGE_BACKEND=local
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=trip/uploads
S3_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_ALLOW_HTTP=false
OUTBOUND_REQUIRE_ACTOR_CONTEXT=false
OUTBOUND_USER_DAILY_TEXT_LIMIT=100
OUTBOUND_USER_DAILY_EMBEDDING_LIMIT=500
OUTBOUND_USER_DAILY_AMAP_LIMIT=1000
ACME_EMAIL=
PUBLIC_EDGE_CIDR=172.30.244.0/28
DB_POOL_MAX_SIZE=12
DB_POOL_MIN_IDLE=4
# 选择 docker-compose.cloud-db.yml 时挂载的供应商 CA 目录。
TRIP_POSTGRES_CA_DIR=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
TRIP_TASK_TIMEOUT_SECONDS=300
TRIP_TASK_QUEUE_LIMIT=32

# 真实模型评测必须主动启用并设置调用上限、美元预算及模型单价。
# 上限按单进程评测会话累计；重启会重置，不能当作供应商账单硬限额。
LIVE_EVAL_ENABLED=false
LIVE_EVAL_MAX_CALLS=0
LIVE_EVAL_MAX_COST_USD=0
