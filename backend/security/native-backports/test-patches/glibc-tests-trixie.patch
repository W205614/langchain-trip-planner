--- a/elf/tst-dl-path-normalize.c
+++ b/elf/tst-dl-path-normalize.c
@@ -22,6 +22,28 @@
 #include <string.h>
 #include <support/check.h>
 #include <support/next_to_fault.h>
+#include <support/xunistd.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+/* glibc 2.41 has only the trailing-guard allocator.  Keep the upstream
+   leading-guard cases using the same mmap/mprotect contract locally.  */
+static struct support_next_to_fault
+support_next_to_fault_allocate_before (size_t size)
+{
+  long page_size = sysconf (_SC_PAGESIZE);
+  TEST_VERIFY_EXIT (page_size > 0);
+  TEST_VERIFY_EXIT (size <= (size_t) page_size);
+  struct support_next_to_fault result;
+  result.region_size = 2 * page_size;
+  result.region_start = xmmap (NULL, result.region_size,
+                              PROT_READ | PROT_WRITE,
+                              MAP_PRIVATE | MAP_ANONYMOUS, -1);
+  xmprotect (result.region_start, page_size, PROT_NONE);
+  result.buffer = (char *) result.region_start + page_size;
+  result.length = size;
+  return result;
+}
 
 static void
 check_one_guarded (const char *input, const char *expected, bool before)
