+  /* Use the direct non-cancelable syscall: the vDSO getrandom path may
+     allocate state.  Do not derive the offset from libc addresses or guards,
+     or silently use a fixed offset when independent entropy is unavailable.  */
+  uintptr_t random_offset;
+  if (__getrandom_nocancel_nostatus_direct (&random_offset,
+                                           sizeof (random_offset),
+                                           GRND_NONBLOCK)
+      != sizeof (random_offset))
+    __libc_fatal ("malloc: cannot initialize arena randomization\n");
+
+  /* Explicit huge pages and their ordinary-page fallback must use one
+     offset so heap_for_ptr remains unambiguous.  */
+  size_t arena_pagesize = (mp_.hp_pagesize != 0
+                           ? mp_.hp_pagesize : GLRO (dl_pagesize));
+  arena_offset = ALIGN_DOWN (random_offset & (heap_max_size () - 1),
+                             arena_pagesize);
 }
 
