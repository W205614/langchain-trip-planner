# Only the isolated edge network may supply forwarded client identity and scheme.
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;
geo $realip_remote_addr $trip_trusted_proxy {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}
map "$trip_trusted_proxy:$http_x_forwarded_proto" $trip_request_scheme {
    default $scheme;
    "1:https" https;
    "1:http" http;
}
include /etc/nginx/trip-common.conf;
